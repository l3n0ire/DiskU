<Window
    x:Class="DiskU.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DiskU.App"
    Title="DiskU">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" PreviewKeyDown="Root_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: sidebar toggle (browser only), icon, title, menus; the toolbar on the right (Mac §1.3). -->
        <TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="DiskU" IsPaneToggleButtonVisible="False" PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.Resources>
                <!-- Menus sit left, next to the title (the default centers the content). -->
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Left</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <MenuBar x:Name="Menus" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <MenuBarItem x:Name="FileMenu">
                        <MenuFlyoutItem x:Name="ScanFolderItem" Click="ScanFolder_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED25;" /></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="O" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ScanHomeItem" Click="ScanHome_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE80F;" /></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="H" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ScanFullDiskItem" Click="ScanFullDisk_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDA2;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="RescanItem" Click="Rescan_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="R" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuBarItem>
                    <MenuBarItem x:Name="ItemMenu">
                        <MenuFlyoutItem x:Name="RevealItem" Click="Reveal_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="R" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="OpenItem" Click="Open_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="Down" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="CopyPathItem" Click="CopyPath_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Menu" Key="C" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ZoomOutItem" Click="ZoomOut_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71F;" /></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="Up" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="TrashItem" Click="Trash_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Delete" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuBarItem>
                </MenuBar>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <StackPanel x:Name="Toolbar" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,4,0">
                    <StackPanel.Resources>
                        <!-- Icon-only buttons: no fill or border at rest or when disabled. -->
                        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="SplitButtonBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="SplitButtonBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="SplitButtonBorderBrushPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="SplitButtonBorderBrushChecked" Color="Transparent" />
                        <SolidColorBrush x:Key="SplitButtonBorderBrushDivider" Color="Transparent" />
                    </StackPanel.Resources>
                    <Button x:Name="CancelButton" Style="{StaticResource ToolbarButtonStyle}" Click="Cancel_Click" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE711;" FontSize="16" />
                    </Button>
                    <Button x:Name="RescanButton" Style="{StaticResource ToolbarButtonStyle}" Click="Rescan_Click">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    </Button>
                    <Button x:Name="HomeButton" Style="{StaticResource ToolbarButtonStyle}" Click="ScanHome_Click">
                        <FontIcon Glyph="&#xE80F;" FontSize="16" />
                    </Button>
                    <SplitButton x:Name="FullDiskButton" Height="34" Padding="10,0,6,0" Click="FullDisk_Click">
                        <FontIcon Glyph="&#xEDA2;" FontSize="16" />
                        <SplitButton.Flyout>
                            <MenuFlyout x:Name="DrivesMenu" Placement="BottomEdgeAlignedRight" Opening="DrivesMenu_Opening" />
                        </SplitButton.Flyout>
                    </SplitButton>
                    <Button x:Name="ScanButton" Style="{StaticResource ToolbarButtonStyle}" Click="ScanFolder_Click">
                        <FontIcon Glyph="&#xED25;" FontSize="16" />
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <!-- Update banner (Mac §1.11): top of the content in every state. -->
        <InfoBar x:Name="UpdateBar" Grid.Row="1" Severity="Informational" IsOpen="False" IsClosable="True"
                 Margin="12,0,12,8" CloseButtonClick="UpdateBar_CloseButtonClick">
            <InfoBar.IconSource>
                <FontIconSource Glyph="&#xE896;" />
            </InfoBar.IconSource>
            <InfoBar.ActionButton>
                <Button x:Name="ViewReleaseButton" Click="ViewRelease_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="2">
            <!-- Welcome (state Idle). -->
            <ScrollViewer x:Name="WelcomeView" VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" Padding="40">
                    <FontIcon Glyph="&#xF0E2;" FontSize="64" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="WelcomeTitle" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="WelcomeSubtitle" Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="440" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Button x:Name="WelcomeHome" Style="{StaticResource AccentButtonStyle}" MinWidth="170" Padding="16,9" Click="ScanHome_Click" />
                        <Button x:Name="WelcomeFullDisk" MinWidth="170" Padding="16,9" Click="ScanFullDisk_Click" />
                        <Button x:Name="WelcomeChoose" MinWidth="170" Padding="16,9" Click="ScanFolder_Click" />
                    </StackPanel>

                    <!-- Administrator card (replaces the Mac's Full Disk Access card). -->
                    <Border x:Name="AdminCard" Margin="0,12,0,0" Padding="20,18" MaxWidth="460" CornerRadius="8" BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xEA18;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="AdminTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="AdminBody" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="AdminButton" HorizontalAlignment="Center" Click="RestartAdmin_Click" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="AdminOnRow" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <FontIcon Glyph="&#xEA18;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock x:Name="AdminOn" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- A thin indeterminate bar along the top edge while a scan runs. -->
            <ProgressBar x:Name="ScanBar" IsIndeterminate="True" VerticalAlignment="Top" Visibility="Collapsed" />

            <!-- Scanning (state Scanning). -->
            <StackPanel x:Name="ScanningView" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Padding="40" Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="56" Height="56" HorizontalAlignment="Center" />
                <!-- Shortened in the middle so the scanned folder's own name stays visible. -->
                <local:MiddleTrimmedText x:Name="ScanningTitle" HorizontalAlignment="Center" MaxWidth="640" FontSize="20" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="28" HorizontalAlignment="Center">
                    <StackPanel Spacing="2" MinWidth="120">
                        <TextBlock x:Name="FilesValue" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="FilesCaption" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Spacing="2" MinWidth="120">
                        <TextBlock x:Name="BytesValue" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="BytesCaption" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <local:MiddleTrimmedText x:Name="CurrentPath" MaxWidth="560" HorizontalAlignment="Center" FontSize="12"
                                         FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="ScanningCancel" HorizontalAlignment="Center" MinWidth="110" Click="Cancel_Click">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" />
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>

            <!-- Failure (state Failed). -->
            <StackPanel x:Name="FailureView" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Padding="40" MaxWidth="560" Visibility="Collapsed">
                <FontIcon Glyph="&#xE7BA;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="FailureTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock x:Name="FailureMessage" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                <Button x:Name="TryAgainButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" MinWidth="110" Click="Rescan_Click" />
            </StackPanel>

            <!-- Browser (state Done). -->
            <local:BrowserView x:Name="Browser" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
